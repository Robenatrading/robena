---
import "../styles/global.css";
import Header from "../components/Header.astro";
import SeapSection from "../components/SeapSection.astro";
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Produs ROBENA TRADING."
    />

    <link rel="icon" type="image/png" href="/favicon.png?v=2" />

    <title>
      Produs | ROBENA TRADING
    </title>
  </head>

  <body class="bg-slate-50 text-slate-900">
    <Header />

    <main>
      <section class="mx-auto max-w-7xl px-6 py-12">
        <div
          id="loading-produs"
          class="mx-auto max-w-2xl rounded-2xl bg-white p-10 text-center shadow-sm"
        >
          <p class="text-lg font-semibold">
            Se încarcă produsul...
          </p>
        </div>

        <div
          id="eroare-produs"
          class="mx-auto hidden max-w-2xl rounded-2xl bg-red-50 p-10 text-center text-red-700 shadow-sm"
        >
          <p class="text-lg font-semibold">
            Produsul nu a putut fi încărcat.
          </p>

          <a
            href="/#produse"
            class="mt-6 inline-flex rounded-xl bg-blue-700 px-6 py-3 font-semibold text-white"
          >
            Înapoi la produse
          </a>
        </div>

        <article
          id="continut-produs"
          class="hidden"
        >
          <nav class="mb-8 text-sm text-slate-500">
            <a
              href="/"
              class="hover:text-blue-700"
            >
              Acasă
            </a>

            <span class="mx-2">/</span>

            <a
              id="link-categorie-sus"
              href="/#produse"
              class="hover:text-blue-700"
            >
              Produse
            </a>

            <span class="mx-2">/</span>

            <span id="breadcrumb-produs"></span>
          </nav>

          <div class="grid items-start gap-12 lg:grid-cols-2">
            <div
              class="flex min-h-[420px] items-center justify-center rounded-2xl bg-white p-8 shadow-sm"
            >
              <img
                id="imagine-produs"
                src=""
                alt=""
                class="max-h-[560px] w-full object-contain"
              />
            </div>

            <div>
              <p
                id="categorie-produs"
                class="text-sm font-bold uppercase tracking-[0.18em] text-blue-700"
              ></p>

              <h1
                id="nume-produs"
                class="mt-3 text-3xl font-bold tracking-tight md:text-5xl"
              ></h1>

              <div
                id="descriere-produs"
                class="mt-7 whitespace-pre-line text-lg leading-8 text-slate-600"
              ></div>

              <a
                id="buton-oferta"
                href="/contact/"
                class="mt-9 inline-flex rounded-xl bg-blue-700 px-7 py-4 font-semibold text-white transition hover:bg-blue-800"
              >
                Solicită ofertă
              </a>
            </div>
          </div>
        </article>
      </section>

      <SeapSection />
    </main>

    <script>
      import { supabase } from "../lib/supabase.js";

      const loadingProdus =
        document.querySelector("#loading-produs");

      const eroareProdus =
        document.querySelector("#eroare-produs");

      const continutProdus =
        document.querySelector("#continut-produs");

      const numeProdus =
        document.querySelector("#nume-produs");

      const descriereProdus =
        document.querySelector("#descriere-produs");

      const imagineProdus =
        document.querySelector("#imagine-produs");

      const categorieProdus =
        document.querySelector("#categorie-produs");

      const breadcrumbProdus =
        document.querySelector("#breadcrumb-produs");

      const linkCategorieSus =
        document.querySelector("#link-categorie-sus");

      const butonOferta =
        document.querySelector("#buton-oferta");

      const params =
        new URLSearchParams(window.location.search);

      const produsSlug =
        params.get("slug")?.trim() || "";

      function afiseazaEroare() {
        loadingProdus.classList.add("hidden");
        continutProdus.classList.add("hidden");
        eroareProdus.classList.remove("hidden");
      }

      async function incarcaProdus() {
        if (!produsSlug) {
          afiseazaEroare();
          return;
        }

        const { data: produs, error: produsError } =
          await supabase
            .from("produse")
            .select(`
              id,
              nume,
              slug,
              descriere,
              imagine,
              categorie_id
            `)
            .eq("slug", produsSlug)
            .single();

        if (produsError || !produs) {
          console.error(
            "Produsul nu a putut fi încărcat:",
            produsError
          );

          afiseazaEroare();
          return;
        }

        const { data: categorie, error: categorieError } =
          await supabase
            .from("categorii")
            .select("id, nume, slug")
            .eq("id", produs.categorie_id)
            .single();

        if (categorieError || !categorie) {
          console.error(
            "Categoria nu a putut fi încărcată:",
            categorieError
          );

          afiseazaEroare();
          return;
        }

        document.title =
          `${produs.nume} | ROBENA TRADING`;

        numeProdus.textContent =
          produs.nume || "";

        descriereProdus.textContent =
          produs.descriere || "";

        imagineProdus.src =
          produs.imagine || "";

        imagineProdus.alt =
          produs.nume || "Produs ROBENA TRADING";

        categorieProdus.textContent =
          categorie.nume || "";

        breadcrumbProdus.textContent =
          produs.nume || "";

        linkCategorieSus.textContent =
          categorie.nume || "Produse";

        linkCategorieSus.href =
          `/produse/${categorie.slug}/`;

        butonOferta.href =
          `/contact/?produs=${encodeURIComponent(produs.nume)}`;

        loadingProdus.classList.add("hidden");
        eroareProdus.classList.add("hidden");
        continutProdus.classList.remove("hidden");
      }

      incarcaProdus();
    </script>
  </body>
</html>
