---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Mobilier de birou oferit de ROBENA TRADING pentru instituții, companii și spații profesionale."
    />

    <title>Mobilier de birou | ROBENA TRADING</title>
  </head>

  <body class="bg-slate-50 text-slate-900">
    <Header />

    <main>
      <section class="mx-auto max-w-7xl px-6 pt-8 pb-16">
        <div class="mx-auto max-w-3xl text-center">
          <h1 class="mt-4 text-4xl font-bold text-slate-900 md:text-5xl">
            Mobilier de birou
          </h1>

          <p class="mt-6 text-lg leading-8 text-slate-600">
            Descoperă gama noastră de mobilier de birou pentru instituții,
            companii, școli, universități și alte spații profesionale.
          </p>
        </div>

        <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">


<article
  class="overflow-hidden rounded-2xl bg-white transition hover:-translate-y-1"
>
  <a
    href="/produse/mobilier-de-birou/birou-profesional"
    class="block"
  >
    <div class="flex h-72 items-center justify-center overflow-hidden bg-white p-4">
      <img
src="/images/categorii/mobilier-de-birou-robena-trading.png"
        alt="Birou profesional"
        class="h-full w-full object-contain"
      />
    </div>

    <div class="p-6">
      <h2 class="text-xl font-bold text-slate-900 hover:text-blue-700">
        Birou profesional
      </h2>

      <p class="mt-3 leading-7 text-slate-600">
        Birou profesional cu sertare și spațiu de depozitare, ideal pentru
        birouri, instituții publice, companii și cabinete.
      </p>
    </div>
  </a>

  <div class="px-6 pb-6">
    <a
      href="/contact"
      class="inline-flex rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white transition hover:bg-blue-800"
    >
      Solicită ofertă
    </a>
  </div>
</article>
<!-- Dulap de birou -->
<article
  class="overflow-hidden rounded-2xl bg-white transition hover:-translate-y-1"
>
  <a
    href="/produse/mobilier-de-birou/dulap-birou"
    class="block"
  >
    <div class="flex h-72 items-center justify-center overflow-hidden bg-white p-4">
      <img
        src="/images/categorii/dulap-birou-robena-trading.png"
        alt="Dulap de birou"
        class="h-full w-full object-contain"
      />
    </div>

    <div class="p-6">
      <h2 class="text-xl font-bold text-slate-900 hover:text-blue-700">
        Dulap de birou
      </h2>

      <p class="mt-3 leading-7 text-slate-600">
        Dulap de birou cu sertare și compartiment cu ușă, potrivit pentru
        depozitarea documentelor, materialelor și obiectelor de lucru.
      </p>
    </div>
  </a>

  <div class="px-6 pb-6">
    <a
      href="/contact"
      class="inline-flex rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white transition hover:bg-blue-800"
    >
      Solicită ofertă
    </a>
  </div>
</article>
<!-- Scaun de birou -->
<article
  class="overflow-hidden rounded-2xl bg-white transition hover:-translate-y-1"
>
  <a
    href="/produse/mobilier-de-birou/scaun-birou"
    class="block"
  >
    <div class="flex h-72 items-center justify-center overflow-hidden bg-white p-4">
      <img
        src="/images/categorii/scaun-de-birou-robena-trading.png"
        alt="Scaun de birou"
        class="h-full w-full object-contain"
      />
    </div>

    <div class="p-6">
      <h2 class="text-xl font-bold text-slate-900 hover:text-blue-700">
        Scaun de birou
      </h2>

      <p class="mt-3 leading-7 text-slate-600">
        Scaune de birou profesionale disponibile într-o gamă variată de modele,
        potrivite pentru instituții, companii și spații administrative.
      </p>
    </div>
  </a>

  <div class="px-6 pb-6">
    <a
      href="/contact"
      class="inline-flex rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white transition hover:bg-blue-800"
    >
      Solicită ofertă
    </a>
  </div>
</article>
        </div>
      </section>
    </main>
  </body>
</html>