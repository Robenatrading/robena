---
import "../../../styles/global.css";
import Header from "../../../components/Header.astro";
import SeapSection from "../../../components/SeapSection.astro";
import { supabase } from "../../../lib/supabase.js";

export async function getStaticPaths() {
  const { data: produse, error: produseError } = await supabase
    .from("produse")
    .select(
      "id, nume, slug, descriere, imagine, ordine, categorie_id"
    )
    .order("ordine", { ascending: true });

  if (produseError) {
    throw new Error(
      `Nu s-au putut încărca produsele din Supabase: ${produseError.message}`
    );
  }

  const { data: categorii, error: categoriiError } = await supabase
    .from("categorii")
    .select("id, nume, slug");

  if (categoriiError) {
    throw new Error(
      `Nu s-au putut încărca categoriile din Supabase: ${categoriiError.message}`
    );
  }

  return (produse ?? [])
    .map((produs) => {
      const categorie = (categorii ?? []).find(
        (categorie) => categorie.id === produs.categorie_id
      );

      if (!categorie) {
        return null;
      }

      return {
        params: {
          categorie: categorie.slug,
          produs: produs.slug,
        },
        props: {
          produs,
          categorie,
        },
      };
    })
    .filter(Boolean);
}

const { produs, categorie } = Astro.props;

const siteUrl = "https://robena.ro";

const productUrl =
  `${siteUrl}/produse/${categorie.slug}/${produs.slug}/`;

const seoTitle =
  `${produs.nume} | ${categorie.nume} | ROBENA TRADING`;

const seoDescription =
  produs.descriere?.length > 155
    ? `${produs.descriere.slice(0, 152)}...`
    : produs.descriere;

const productImage =
  produs.imagine?.startsWith("http")
    ? produs.imagine
    : `${siteUrl}${produs.imagine}`;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: produs.nume,
  description: produs.descriere,
  image: [productImage],
  category: categorie.nume,
  url: productUrl,
  sku: String(produs.id),
  brand: {
    "@type": "Brand",
    name: "ROBENA TRADING",
  },
  manufacturer: {
    "@type": "Organization",
    name: "ROBENA TRADING",
    url: siteUrl,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": productUrl,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Acasă",
      item: siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: categorie.nume,
      item: `${siteUrl}/produse/${categorie.slug}/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: produs.nume,
      item: productUrl,
    },
  ],
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: seoTitle,
  description: seoDescription,
  url: productUrl,
  inLanguage: "ro-RO",
  isPartOf: {
    "@type": "WebSite",
    name: "ROBENA TRADING",
    url: siteUrl,
  },
  about: {
    "@type": "Product",
    name: produs.nume,
  },
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{seoTitle}</title>

    <meta
      name="description"
      content={seoDescription}
    />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <meta
      name="googlebot"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <link
      rel="canonical"
      href={productUrl}
    />

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png?v=2"
    />

    <!-- Open Graph -->
    <meta
      property="og:type"
      content="product"
    />

    <meta
      property="og:locale"
      content="ro_RO"
    />

    <meta
      property="og:site_name"
      content="ROBENA TRADING"
    />

    <meta
      property="og:title"
      content={seoTitle}
    />

    <meta
      property="og:description"
      content={seoDescription}
    />

    <meta
      property="og:url"
      content={productUrl}
    />

    <meta
      property="og:image"
      content={productImage}
    />

    <meta
      property="og:image:alt"
      content={`${produs.nume} - ${categorie.nume} - ROBENA TRADING`}
    />

    <!-- Social -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={seoTitle}
    />

    <meta
      name="twitter:description"
      content={seoDescription}
    />

    <meta
      name="twitter:image"
      content={productImage}
    />

    <!-- Date structurate -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(productSchema)}
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(webPageSchema)}
    ></script>
  </head>

  <body class="min-h-screen bg-white text-slate-900">
    <Header />

    <main>
      <section class="mx-auto max-w-7xl px-6 py-12">
        <nav
          class="mb-8 text-sm text-slate-600"
          aria-label="Navigare"
        >
          <a
            href="/"
            class="transition hover:text-blue-700"
          >
            Acasă
          </a>

          <span class="mx-2">/</span>

          <a
            href={`/produse/${categorie.slug}/`}
            class="transition hover:text-blue-700"
          >
            {categorie.nume}
          </a>

          <span class="mx-2">/</span>

          <span class="font-semibold text-slate-900">
            {produs.nume}
          </span>
        </nav>

        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div class="flex min-h-[420px] items-center justify-center">
            <img
              src={produs.imagine}
              alt={`${produs.nume} - ${categorie.nume} - ROBENA TRADING`}
              class="max-h-[520px] w-full object-contain"
              loading="eager"
            />
          </div>

          <div>
            <p class="font-semibold text-blue-700">
              {categorie.nume}
            </p>

            <h1
              class="mt-3 text-4xl font-bold tracking-tight md:text-5xl"
            >
              {produs.nume}
            </h1>

            <p class="mt-6 text-lg leading-8 text-slate-600">
              {produs.descriere}
            </p>

            <a
              href="/contact/"
              class="mt-8 inline-flex rounded-xl bg-blue-700 px-7 py-3 font-semibold text-white transition hover:bg-blue-800"
            >
              Solicită ofertă
            </a>
          </div>
        </div>
      </section>

      <SeapSection />
    </main>
  </body>
</html>