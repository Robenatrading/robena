---
import "../../../styles/global.css";
import Header from "../../../components/Header.astro";
import SeapSection from "../../../components/SeapSection.astro";
import { supabase } from "../../../lib/supabase.js";

export async function getStaticPaths() {
  const { data: produse, error: produseError } = await supabase
    .from("produse")
    .select(
      "id, nume, slug, descriere, imagine, ordine, categorie_id"
    )
    .order("ordine", { ascending: true });

  if (produseError) {
    throw new Error(
      `Nu s-au putut încărca produsele din Supabase: ${produseError.message}`
    );
  }

  const { data: categorii, error: categoriiError } = await supabase
    .from("categorii")
    .select("id, nume, slug");

  if (categoriiError) {
    throw new Error(
      `Nu s-au putut încărca categoriile din Supabase: ${categoriiError.message}`
    );
  }

  return (produse ?? [])
    .map((produs) => {
      const categorie = (categorii ?? []).find(
        (categorie) => categorie.id === produs.categorie_id
      );

      if (!categorie) {
        return null;
      }

      return {
        params: {
          categorie: categorie.slug,
          produs: produs.slug,
        },
        props: {
          produs,
          categorie,
        },
      };
    })
    .filter(Boolean);
}

const { produs, categorie } = Astro.props;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={produs.descriere}
    />

    <link rel="icon" type="image/png" href="/favicon.png?v=2" />

    <title>{produs.nume} | ROBENA TRADING</title>
  </head>

  <body class="bg-slate-50 text-slate-900">
    <Header />

    <main>
      <section class="mx-auto max-w-7xl px-6 py-12">
        <nav class="mb-8 text-sm text-slate-600" aria-label="Navigare">
          <a href="/" class="transition hover:text-blue-700">
            Acasă
          </a>

          <span class="mx-2">/</span>

          <a
            href={`/produse/${categorie.slug}/`}
            class="transition hover:text-blue-700"
          >
            {categorie.nume}
          </a>

          <span class="mx-2">/</span>

          <span class="font-semibold text-slate-900">
            {produs.nume}
          </span>
        </nav>

        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div
            class="flex min-h-[420px] items-center justify-center rounded-2xl bg-white p-8 shadow-sm"
          >
            <img
              src={produs.imagine}
              alt={produs.nume}
              class="max-h-[520px] w-full object-contain"
            />
          </div>

          <div>
            <p class="font-semibold text-blue-700">
              {categorie.nume}
            </p>

            <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">
              {produs.nume}
            </h1>

            <p class="mt-6 text-lg leading-8 text-slate-600">
              {produs.descriere}
            </p>

            <a
              href="/contact/"
              class="mt-8 inline-flex rounded-xl bg-blue-700 px-7 py-3 font-semibold text-white transition hover:bg-blue-800"
            >
              Solicită ofertă
            </a>
          </div>
        </div>
      </section>

      <SeapSection />
    </main>
  </body>
</html>