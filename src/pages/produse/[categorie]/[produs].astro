---
import "../../../styles/global.css";
import Header from "../../../components/Header.astro";
import SeapSection from "../../../components/SeapSection.astro";
import Footer from "../../../components/Footer.astro";
import { supabase } from "../../../lib/supabase.js";
import { imagineRapida } from "../../../lib/imagini.js";
import {
  descriereHtml,
  descriereScurta,
  descriereText,
} from "../../../lib/descriere.js";

export async function getStaticPaths() {
  const { data: produse, error: produseError } = await supabase
    .from("produse")
    .select(
      "id, nume, slug, descriere, imagine, ordine, categorie_id"
    )
    .order("ordine", { ascending: true });

  if (produseError) {
    throw new Error(
      `Nu s-au putut încărca produsele din Supabase: ${produseError.message}`
    );
  }

  const { data: categorii, error: categoriiError } = await supabase
    .from("categorii")
    .select("id, nume, slug");

  if (categoriiError) {
    throw new Error(
      `Nu s-au putut încărca categoriile din Supabase: ${categoriiError.message}`
    );
  }

  return (produse ?? [])
    .map((produs) => {
      const categorie = (categorii ?? []).find(
        (categorie) => categorie.id === produs.categorie_id
      );

      if (!categorie) {
        return null;
      }

      // Alte produse din aceeași categorie (legături interne)
      const produseSimilare = (produse ?? [])
        .filter(
          (p) =>
            p.categorie_id === produs.categorie_id &&
            p.id !== produs.id
        )
        .slice(0, 6);

      return {
        params: {
          categorie: categorie.slug,
          produs: produs.slug,
        },
        props: {
          produs,
          categorie,
          produseSimilare,
        },
      };
    })
    .filter(Boolean);
}

const { produs, categorie, produseSimilare = [] } = Astro.props;

const siteUrl = "https://robena.ro";

const productUrl =
  `${siteUrl}/produse/${categorie.slug}/${produs.slug}/`;

const seoTitle =
  `${produs.nume} | ${categorie.nume} | ROBENA TRADING`;

const seoDescription =
  descriereScurta(produs.descriere, produs.nume) ||
  `${produs.nume} pentru spitale, clinici, instituții și companii. Solicitați ofertă de la ROBENA TRADING.`;

const continutDescriere = descriereHtml(produs.descriere, produs.nume);

const productImage =
  produs.imagine?.startsWith("http")
    ? produs.imagine
    : `${siteUrl}${produs.imagine}`;


/* =========================================================
   DATE STRUCTURATE - BREADCRUMBS
   ========================================================= */

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Acasă",
      item: siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: categorie.nume,
      item: `${siteUrl}/produse/${categorie.slug}/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: produs.nume,
      item: productUrl,
    },
  ],
};


/* =========================================================
   DATE STRUCTURATE - PAGINA WEB
   ========================================================= */

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${productUrl}#webpage`,
  url: productUrl,
  name: seoTitle,
  description: seoDescription,
  inLanguage: "ro-RO",
  isPartOf: {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    name: "ROBENA TRADING",
    url: siteUrl,
  },
};


/* =========================================================
   Fără schema „Product”: pe site nu sunt prețuri, iar Google
   o marchează ca „problemă critică” (lipsește offers).
   Se poate readăuga când produsele vor avea preț afișat.
   ========================================================= */
---

<!doctype html>

<html lang="ro">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{seoTitle}</title>

    <meta
      name="description"
      content={seoDescription}
    />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <meta
      name="googlebot"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <link
      rel="canonical"
      href={productUrl}
    />

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png?v=2"
    />


    <!-- =====================================================
         OPEN GRAPH
         ===================================================== -->

    <meta
      property="og:type"
      content="product"
    />

    <meta
      property="og:locale"
      content="ro_RO"
    />

    <meta
      property="og:site_name"
      content="ROBENA TRADING"
    />

    <meta
      property="og:title"
      content={seoTitle}
    />

    <meta
      property="og:description"
      content={seoDescription}
    />

    <meta
      property="og:url"
      content={productUrl}
    />

    <meta
      property="og:image"
      content={productImage}
    />

    <meta
      property="og:image:alt"
      content={`${produs.nume} - ${categorie.nume} - ROBENA TRADING`}
    />


    <!-- =====================================================
         TWITTER / SOCIAL
         ===================================================== -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={seoTitle}
    />

    <meta
      name="twitter:description"
      content={seoDescription}
    />

    <meta
      name="twitter:image"
      content={productImage}
    />


    <!-- =====================================================
         DATE STRUCTURATE JSON-LD
         ===================================================== -->

    <!-- Breadcrumbs -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    ></script>


    <!-- WebPage -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify(webPageSchema)}
    ></script>



  </head>


  <body class="min-h-screen bg-white text-slate-900">

    <Header />


    <main>

      <section class="mx-auto max-w-7xl px-6 py-12">

        <!-- Breadcrumb vizibil -->

        <nav
          class="mb-8 text-sm text-slate-600"
          aria-label="Navigare"
        >

          <a
            href="/"
            class="transition hover:text-blue-700"
          >
            Acasă
          </a>

          <span class="mx-2">/</span>

          <a
            href={`/produse/${categorie.slug}/`}
            class="transition hover:text-blue-700"
          >
            {categorie.nume}
          </a>

          <span class="mx-2">/</span>

          <span class="font-semibold text-slate-900">
            {produs.nume}
          </span>

        </nav>


        <!-- Produs -->

        <div class="grid items-start gap-12 lg:grid-cols-2">

          <!-- Imagine produs -->

          <div class="flex min-h-[420px] items-center justify-center lg:sticky lg:top-28">

            <img
              src={imagineRapida(produs.imagine)}
              alt={`${produs.nume} - ${categorie.nume} - ROBENA TRADING`}
              class="max-h-[520px] w-full object-contain"
              loading="eager"
              fetchpriority="high"
            />

          </div>


          <!-- Informații produs -->

          <div>

            <p class="font-semibold text-blue-700">
              {categorie.nume}
            </p>

            <h1
              class="mt-3 text-4xl font-bold tracking-tight md:text-5xl"
            >
              {produs.nume}
            </h1>

            <div
              class="descriere-produs mt-6"
              set:html={continutDescriere}
            />

            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href={`/contact/?produs=${encodeURIComponent(produs.nume)}`}
                class="inline-flex rounded-xl bg-blue-700 px-7 py-3 font-semibold text-white transition hover:bg-blue-800"
              >
                Solicită ofertă
              </a>

              <a
                href="tel:+40740413699"
                class="font-semibold text-slate-700 transition hover:text-blue-700"
              >
                sau sunați: 0740 413 699
              </a>
            </div>

          </div>

        </div>

      </section>


      {
        produseSimilare.length > 0 && (
          <section class="mx-auto max-w-7xl px-6 pb-16">
            <h2 class="text-2xl font-bold tracking-tight md:text-3xl">
              Alte produse din categoria {categorie.nume}
            </h2>

            <div class="mt-8 grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-6">
              {produseSimilare.map((p) => (
                <a
                  href={`/produse/${categorie.slug}/${p.slug}/`}
                  class="group block"
                >
                  <div class="flex h-36 items-center justify-center p-2">
                    <img
                      src={imagineRapida(p.imagine)}
                      alt={`${p.nume} - ${categorie.nume}`}
                      class="h-full w-full object-contain transition duration-300 group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>

                  <p class="mt-3 text-sm font-semibold leading-5 text-slate-900 group-hover:text-blue-700">
                    {p.nume}
                  </p>
                </a>
              ))}
            </div>

            <a
              href={`/produse/${categorie.slug}/`}
              class="mt-8 inline-block font-semibold text-blue-700 hover:text-blue-800"
            >
              Vezi toate produsele din categoria {categorie.nume} →
            </a>
          </section>
        )
      }

      <SeapSection />

    </main>

    <Footer />

  </body>

</html>