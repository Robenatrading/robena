---
import "../../../styles/global.css";
import Header from "../../../components/Header.astro";
import { produse } from "../../../data/produse.js";

export function getStaticPaths() {
  const categoriiUnice = [
    ...new Map(
      produse.map((produs) => [
        produs.categorie,
        {
          slug: produs.categorie,
          nume: produs.categorieNume,
        },
      ])
    ).values(),
  ];

  return categoriiUnice.map((categorie) => ({
    params: {
      categorie: categorie.slug,
    },

    props: {
      categorie,
    },
  }));
}

const { categorie } = Astro.props;

const produseCategorie = produse.filter(
  (produs) => produs.categorie === categorie.slug
);
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={`Produse din categoria ${categorie.nume} oferite de ROBENA TRADING.`}
    />

    <title>{categorie.nume} | ROBENA TRADING</title>
  </head>

  <body class="bg-slate-50 text-slate-900">
    <Header />

    <main>
      <section class="mx-auto max-w-7xl px-6 py-16">
        <div class="text-center">
          <p class="font-semibold uppercase tracking-[0.3em] text-blue-700">
            Produse
          </p>

          <h1 class="mt-4 text-4xl font-bold md:text-5xl">
            {categorie.nume}
          </h1>

          <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-slate-600">
            Descoperiți gama noastră de produse, disponibile în diferite
            configurații și cu posibilitatea adaptării în funcție de cerințele
            beneficiarului.
          </p>
        </div>

        <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            produseCategorie.map((produs) => (
              <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                <a href={`/produse/${produs.categorie}/${produs.slug}/`}>
                  <div class="flex h-72 items-center justify-center bg-white p-5">
                    <img
                      src={produs.imagine}
                      alt={produs.nume}
                      class="h-full w-full object-contain"
                      loading="lazy"
                    />
                  </div>

                  <div class="border-t border-slate-100 p-6">
                    <h2 class="text-xl font-bold text-slate-900">
                      {produs.nume}
                    </h2>

                    <p class="mt-3 line-clamp-3 leading-7 text-slate-600">
                      {produs.descriere}
                    </p>

                    <span class="mt-5 inline-flex font-semibold text-blue-700">
                      Vezi produsul →
                    </span>
                  </div>
                </a>
              </article>
            ))
          }
        </div>
      </section>
    </main>
  </body>
</html>