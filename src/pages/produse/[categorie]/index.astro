---
import "../../../styles/global.css";
import Header from "../../../components/Header.astro";
import { supabase } from "../../../lib/supabase.js";

export async function getStaticPaths() {
  const { data: categorii, error } = await supabase
    .from("categorii")
    .select("id, nume, slug, imagine, ordine")
    .order("ordine", { ascending: true });

  if (error) {
    throw new Error(
      `Nu s-au putut încărca categoriile din Supabase: ${error.message}`
    );
  }

  return (categorii ?? []).map((categorie) => ({
    params: {
      categorie: categorie.slug,
    },
    props: {
      categorie,
    },
  }));
}

const { categorie } = Astro.props;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={`Descoperă produsele din categoria ${categorie.nume} oferite de ROBENA TRADING.`}
    />

    <link rel="icon" type="image/png" href="/favicon.png?v=2" />

    <title>{categorie.nume} | ROBENA TRADING</title>
  </head>

  <body class="bg-slate-50 text-slate-900">
    <Header />

    <main>
      <section class="mx-auto max-w-7xl px-6 py-12">
        <div class="text-center">
          <h1 class="text-3xl font-bold tracking-tight md:text-4xl">
            {categorie.nume}
          </h1>

          <p class="mx-auto mt-4 max-w-2xl text-slate-600">
            Produse disponibile în diferite variante și configurații,
            adaptate cerințelor beneficiarului.
          </p>
        </div>

        <div
          id="loading-produse"
          class="mx-auto mt-12 max-w-2xl rounded-2xl bg-white p-10 text-center shadow-sm"
        >
          <p class="text-lg font-semibold">
            Se încarcă produsele...
          </p>
        </div>

        <div
          id="eroare-produse"
          class="mx-auto mt-12 hidden max-w-2xl rounded-2xl bg-red-50 p-10 text-center text-red-700 shadow-sm"
        >
          Produsele nu au putut fi încărcate.
        </div>

        <div
          id="lista-produse"
          class="mt-12 hidden grid gap-8 sm:grid-cols-2 lg:grid-cols-3"
        ></div>

        <div
          id="fara-produse"
          class="mx-auto mt-12 hidden max-w-2xl rounded-2xl bg-white p-10 text-center shadow-sm"
        >
          <p class="text-lg font-semibold">
            Produsele din această categorie vor fi adăugate în curând.
          </p>

          <p class="mt-3 text-slate-600">
            Pentru informații și oferte personalizate, ne puteți contacta.
          </p>

          <a
            href="/contact/"
            class="mt-6 inline-flex rounded-xl bg-blue-700 px-6 py-3 font-semibold text-white transition hover:bg-blue-800"
          >
            Contactează-ne
          </a>
        </div>
      </section>
    </main>

    <script define:vars={{ categorieId: categorie.id, categorieSlug: categorie.slug }}>
      import { supabase } from "../../../lib/supabase.js";

      const loadingProduse =
        document.querySelector("#loading-produse");

      const eroareProduse =
        document.querySelector("#eroare-produse");

      const listaProduse =
        document.querySelector("#lista-produse");

      const faraProduse =
        document.querySelector("#fara-produse");

      function escapeHtml(value) {
        return String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      async function incarcaProduse() {
        const { data: produse, error } = await supabase
          .from("produse")
          .select("id, nume, slug, descriere, imagine, ordine")
          .eq("categorie_id", categorieId)
          .order("ordine", { ascending: true });

        loadingProduse.classList.add("hidden");

        if (error) {
          console.error(
            "Eroare la încărcarea produselor:",
            error
          );

          eroareProduse.classList.remove("hidden");
          return;
        }

        if (!produse || produse.length === 0) {
          faraProduse.classList.remove("hidden");
          return;
        }

        listaProduse.innerHTML = produse
          .map((produs) => {
            const imagine = escapeHtml(produs.imagine);
            const nume = escapeHtml(produs.nume);
            const descriere = escapeHtml(produs.descriere);
            const slug = encodeURIComponent(produs.slug);

            return `
              <a
                href="/produse/${categorieSlug}/${slug}/"
                class="group overflow-hidden rounded-2xl bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
              >
                <div class="flex h-72 items-center justify-center p-6">
                  <img
                    src="${imagine}"
                    alt="${nume}"
                    class="h-full w-full object-contain transition duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>

                <div class="p-6 pt-0">
                  <h2 class="text-xl font-bold">
                    ${nume}
                  </h2>

                  <p class="mt-3 line-clamp-3 leading-7 text-slate-600">
                    ${descriere}
                  </p>

                  <span class="mt-5 inline-block font-semibold text-blue-700">
                    Vezi produsul →
                  </span>
                </div>
              </a>
            `;
          })
          .join("");

        listaProduse.classList.remove("hidden");
      }

      incarcaProduse();
    </script>
  </body>
</html>