---
import "../../../styles/global.css";
import Header from "../../../components/Header.astro";
import SeapSection from "../../../components/SeapSection.astro";
import { supabase } from "../../../lib/supabase.js";

export async function getStaticPaths() {
  const { data: categorii, error } = await supabase
    .from("categorii")
    .select("id, nume, slug, imagine, ordine")
    .order("ordine", { ascending: true });

  if (error) {
    throw new Error(
      `Nu s-au putut încărca categoriile din Supabase: ${error.message}`
    );
  }

  return (categorii ?? []).map((categorie) => ({
    params: {
      categorie: categorie.slug,
    },
    props: {
      categorie,
    },
  }));
}

const { categorie } = Astro.props;

const { data: produse, error: produseError } = await supabase
  .from("produse")
  .select("id, nume, slug, descriere, imagine, ordine")
  .eq("categorie_id", categorie.id)
  .order("ordine", { ascending: true });

const siteUrl = "https://robena.ro";

const categoryUrl =
  `${siteUrl}/produse/${categorie.slug}/`;

const seoTitle =
  `${categorie.nume} | Produse profesionale | ROBENA TRADING`;

const seoDescription =
  `Descoperă gama de ${categorie.nume.toLowerCase()} oferită de ROBENA TRADING. Produse profesionale pentru instituții, companii, organizații și alți beneficiari din România.`;

const categorySchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: categorie.nume,
  description: seoDescription,
  url: categoryUrl,
  isPartOf: {
    "@type": "WebSite",
    name: "ROBENA TRADING",
    url: siteUrl,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Acasă",
      item: siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: categorie.nume,
      item: categoryUrl,
    },
  ],
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Produse din categoria ${categorie.nume}`,
  itemListElement: (produse ?? []).map((produs, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: produs.nume,
    url: `${siteUrl}/produse/${categorie.slug}/${produs.slug}/`,
  })),
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{seoTitle}</title>

    <meta
      name="description"
      content={seoDescription}
    />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <link
      rel="canonical"
      href={categoryUrl}
    />

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png?v=2"
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:locale"
      content="ro_RO"
    />

    <meta
      property="og:site_name"
      content="ROBENA TRADING"
    />

    <meta
      property="og:title"
      content={seoTitle}
    />

    <meta
      property="og:description"
      content={seoDescription}
    />

    <meta
      property="og:url"
      content={categoryUrl}
    />

    {
      categorie.imagine && (
        <meta
          property="og:image"
          content={
            categorie.imagine.startsWith("http")
              ? categorie.imagine
              : `${siteUrl}${categorie.imagine}`
          }
        />
      )
    }

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={seoTitle}
    />

    <meta
      name="twitter:description"
      content={seoDescription}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(categorySchema)}
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(itemListSchema)}
    ></script>
  </head>

  <body class="min-h-screen bg-white text-slate-900">
    <Header />

    <main>
      <section class="mx-auto max-w-7xl px-6 py-12">
        <nav
          class="mb-8 text-sm text-slate-600"
          aria-label="Navigare"
        >
          <a
            href="/"
            class="transition hover:text-blue-700"
          >
            Acasă
          </a>

          <span class="mx-2">/</span>

          <span class="font-semibold text-slate-900">
            {categorie.nume}
          </span>
        </nav>

        <div class="text-center">
          <h1 class="text-3xl font-bold tracking-tight md:text-4xl">
            {categorie.nume}
          </h1>

          <p class="mx-auto mt-4 max-w-3xl text-slate-600">
            Descoperă produsele din categoria {categorie.nume},
            disponibile în diferite variante și configurații,
            adaptate cerințelor beneficiarilor.
          </p>
        </div>

        {
          produseError ? (
            <div
              id="eroare-produse"
              class="mx-auto mt-12 max-w-2xl p-10 text-center text-red-700"
            >
              Produsele nu au putut fi încărcate.
            </div>
          ) : (
            <>
              <div
                id="lista-produse"
                data-categorie-id={categorie.id}
                data-categorie-slug={categorie.slug}
                data-categorie-nume={categorie.nume}
                class:list={[
                  "mt-12 grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3",
                  (!produse || produse.length === 0) && "hidden",
                ]}
              >
                {(produse ?? []).map((produs) => (
                  <a
                    href={`/produse/${categorie.slug}/${produs.slug}/`}
                    class="group block bg-transparent"
                  >
                    <div
                      class="flex h-72 items-center justify-center bg-transparent p-4"
                    >
                      <img
                        src={produs.imagine}
                        alt={`${produs.nume} - ${categorie.nume} - ROBENA TRADING`}
                        class="h-full w-full border-0 bg-transparent object-contain shadow-none transition duration-300 group-hover:scale-105"
                        loading="lazy"
                      />
                    </div>

                    <div class="px-1 pt-5">
                      <h2 class="text-xl font-bold text-slate-900">
                        {produs.nume}
                      </h2>

                      <p class="mt-3 line-clamp-3 leading-7 text-slate-600">
                        {produs.descriere}
                      </p>

                      <span class="mt-5 inline-block font-semibold text-blue-700">
                        Vezi produsul →
                      </span>
                    </div>
                  </a>
                ))}
              </div>

              <div
                id="fara-produse"
                class:list={[
                  "mx-auto mt-12 max-w-2xl p-10 text-center",
                  produse && produse.length > 0 && "hidden",
                ]}
              >
                <p class="text-lg font-semibold">
                  Produsele din această categorie vor fi adăugate în curând.
                </p>

                <p class="mt-3 text-slate-600">
                  Pentru informații și oferte personalizate, ne puteți contacta.
                </p>

                <a
                  href="/contact/"
                  class="mt-6 inline-flex rounded-xl bg-blue-700 px-6 py-3 font-semibold text-white transition hover:bg-blue-800"
                >
                  Contactează-ne
                </a>
              </div>
            </>
          )
        }
      </section>

      <SeapSection />
    </main>

    <script>
      import { supabase } from "../../../lib/supabase.js";

      const listaProduse =
        document.querySelector("#lista-produse");

      const faraProduse =
        document.querySelector("#fara-produse");

      if (listaProduse) {
        const categorieId =
          Number(listaProduse.dataset.categorieId);

        const categorieSlug =
          listaProduse.dataset.categorieSlug;

        const categorieNume =
          listaProduse.dataset.categorieNume;

        function escapeHtml(value) {
          return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
        }

        async function actualizeazaProduseleLive() {
          try {
            const {
              data: produseLive,
              error,
            } = await supabase
              .from("produse")
              .select(
                "id, nume, slug, descriere, imagine, ordine"
              )
              .eq("categorie_id", categorieId)
              .order("ordine", {
                ascending: true,
              });

            if (error) {
              console.error(
                "Produsele live nu au putut fi încărcate:",
                error
              );

              return;
            }

            if (
              !produseLive ||
              produseLive.length === 0
            ) {
              listaProduse.innerHTML = "";
              listaProduse.classList.add("hidden");

              if (faraProduse) {
                faraProduse.classList.remove("hidden");
              }

              return;
            }

            if (faraProduse) {
              faraProduse.classList.add("hidden");
            }

            listaProduse.innerHTML =
              produseLive
                .map((produs) => {
                  const nume =
                    escapeHtml(produs.nume);

                  const descriere =
                    escapeHtml(produs.descriere);

                  const imagine =
                    escapeHtml(produs.imagine);

                  const slug =
                    encodeURIComponent(
                      produs.slug
                    );

                  return `
                    <a
                      href="/produse/${categorieSlug}/${slug}/"
                      class="group block bg-transparent"
                    >
                      <div
                        class="flex h-72 items-center justify-center bg-transparent p-4"
                      >
                        <img
                          src="${imagine}"
                          alt="${nume} - ${escapeHtml(categorieNume)} - ROBENA TRADING"
                          class="h-full w-full border-0 bg-transparent object-contain shadow-none transition duration-300 group-hover:scale-105"
                          loading="lazy"
                        />
                      </div>

                      <div class="px-1 pt-5">
                        <h2 class="text-xl font-bold text-slate-900">
                          ${nume}
                        </h2>

                        <p class="mt-3 line-clamp-3 leading-7 text-slate-600">
                          ${descriere}
                        </p>

                        <span class="mt-5 inline-block font-semibold text-blue-700">
                          Vezi produsul →
                        </span>
                      </div>
                    </a>
                  `;
                })
                .join("");

            listaProduse.classList.remove("hidden");
          } catch (error) {
            console.error(
              "Eroare la actualizarea produselor:",
              error
            );
          }
        }

        actualizeazaProduseleLive();
      }
    </script>
  </body>
</html>