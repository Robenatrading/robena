---
import "../../../styles/global.css";
import Header from "../../../components/Header.astro";
import SeapSection from "../../../components/SeapSection.astro";
import Footer from "../../../components/Footer.astro";
import { supabase } from "../../../lib/supabase.js";
import { descriereText } from "../../../lib/descriere.js";
import { seoCategorie } from "../../../lib/categoriiSeo.js";
import { imagineRapida } from "../../../lib/imagini.js";

export async function getStaticPaths() {
  const { data: categorii, error } = await supabase
    .from("categorii")
    .select("id, nume, slug, imagine, ordine")
    .order("ordine", { ascending: true });

  if (error) {
    throw new Error(
      `Nu s-au putut încărca categoriile din Supabase: ${error.message}`
    );
  }

  return (categorii ?? []).map((categorie) => ({
    params: {
      categorie: categorie.slug,
    },
    props: {
      categorie,
    },
  }));
}

const { categorie } = Astro.props;

const { data: produse, error: produseError } = await supabase
  .from("produse")
  .select("id, nume, slug, descriere, imagine, ordine")
  .eq("categorie_id", categorie.id)
  .order("ordine", { ascending: true });

const siteUrl = "https://robena.ro";

const categoryUrl =
  `${siteUrl}/produse/${categorie.slug}/`;

const seoTitle =
  `${categorie.nume} pentru spitale și instituții | ROBENA TRADING`;

const { descriere: seoDescription, intro: introCategorie } =
  seoCategorie(categorie);

const areProduse = !produseError && (produse ?? []).length > 0;

const categorySchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: categorie.nume,
  description: seoDescription,
  url: categoryUrl,
  isPartOf: {
    "@type": "WebSite",
    name: "ROBENA TRADING",
    url: siteUrl,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Acasă",
      item: siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: categorie.nume,
      item: categoryUrl,
    },
  ],
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Produse din categoria ${categorie.nume}`,
  itemListElement: (produse ?? []).map((produs, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: produs.nume,
    url: `${siteUrl}/produse/${categorie.slug}/${produs.slug}/`,
  })),
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{seoTitle}</title>

    <meta
      name="description"
      content={seoDescription}
    />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <link
      rel="canonical"
      href={categoryUrl}
    />

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png?v=2"
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:locale"
      content="ro_RO"
    />

    <meta
      property="og:site_name"
      content="ROBENA TRADING"
    />

    <meta
      property="og:title"
      content={seoTitle}
    />

    <meta
      property="og:description"
      content={seoDescription}
    />

    <meta
      property="og:url"
      content={categoryUrl}
    />

    {
      categorie.imagine && (
        <meta
          property="og:image"
          content={
            categorie.imagine.startsWith("http")
              ? categorie.imagine
              : `${siteUrl}${categorie.imagine}`
          }
        />
      )
    }

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={seoTitle}
    />

    <meta
      name="twitter:description"
      content={seoDescription}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(categorySchema)}
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(itemListSchema)}
    ></script>
  </head>

  <body class="min-h-screen bg-white text-slate-900">
    <Header />

    <main>
      <section class="mx-auto max-w-7xl px-6 py-12">
        <nav
          class="mb-8 text-sm text-slate-600"
          aria-label="Navigare"
        >
          <a
            href="/"
            class="transition hover:text-blue-700"
          >
            Acasă
          </a>

          <span class="mx-2">/</span>

          <span class="font-semibold text-slate-900">
            {categorie.nume}
          </span>
        </nav>

        <div class="text-center">
          <h1 class="text-3xl font-bold tracking-tight md:text-4xl">
            {categorie.nume}
          </h1>

          <p class="mx-auto mt-4 max-w-3xl leading-7 text-slate-600">
            {introCategorie}
          </p>
        </div>

        {
          produseError ? (
            <div
              id="eroare-produse"
              class="mx-auto mt-12 max-w-2xl p-10 text-center text-red-700"
            >
              Produsele nu au putut fi încărcate.
            </div>
          ) : (
            <>
              <div
                id="lista-produse"
                data-categorie-id={categorie.id}
                data-categorie-slug={categorie.slug}
                data-categorie-nume={categorie.nume}
                class:list={[
                  "mt-12 grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3",
                  (!produse || produse.length === 0) && "hidden",
                ]}
              >
                {(produse ?? []).map((produs) => (
                  <a
                    href={`/produse/${categorie.slug}/${produs.slug}/`}
                    class="group block bg-transparent"
                  >
                    <div
                      class="flex h-72 items-center justify-center bg-transparent p-4"
                    >
                      <img
                        src={imagineRapida(produs.imagine)}
                        alt={`${produs.nume} - ${categorie.nume} - ROBENA TRADING`}
                        decoding="async"
                        class="h-full w-full border-0 bg-transparent object-contain shadow-none transition duration-300 group-hover:scale-105"
                        loading="lazy"
                      />
                    </div>

                    <div class="px-1 pt-5">
                      <h2 class="text-xl font-bold text-slate-900">
                        {produs.nume}
                      </h2>

                      <p class="mt-3 line-clamp-3 leading-7 text-slate-600">
                        {descriereText(produs.descriere, produs.nume)}
                      </p>

                      <span class="mt-5 inline-block font-semibold text-blue-700">
                        Vezi produsul →
                      </span>
                    </div>
                  </a>
                ))}
              </div>

              {!areProduse && (
              <div
                id="fara-produse"
                class="mx-auto mt-12 max-w-2xl p-10 text-center"
              >
                <p class="text-lg font-semibold">
                  Produsele din această categorie vor fi adăugate în curând.
                </p>

                <p class="mt-3 text-slate-600">
                  Pentru informații și oferte personalizate, ne puteți contacta.
                </p>

                <a
                  href="/contact/"
                  class="mt-6 inline-flex rounded-xl bg-blue-700 px-6 py-3 font-semibold text-white transition hover:bg-blue-800"
                >
                  Contactează-ne
                </a>
              </div>
              )}
            </>
          )
        }
      </section>

      <SeapSection />
    </main>

    <Footer />

    <!-- Lista de produse vine direct din pagina publicată.
         Site-ul se republică automat la fiecare modificare din admin,
         deci nu mai e nevoie de încărcarea Supabase în browser. -->
  </body>
</html>