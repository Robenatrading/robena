---
import "../styles/global.css";
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Produse existente | ROBENA TRADING</title>
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-900">
    <main class="mx-auto max-w-7xl px-6 py-10">
      <div
        class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h1 class="text-3xl font-bold">
            Produse existente
          </h1>

          <p class="mt-2 text-slate-600">
            Vezi și gestionează produsele ROBENA TRADING.
          </p>
        </div>

        <div class="flex gap-3">
          <a
            href="/admin-adauga-produs/"
            class="rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white hover:bg-blue-800"
          >
            Adaugă produs
          </a>

          <a
            href="/admin-produse/"
            class="rounded-lg bg-slate-900 px-5 py-3 font-semibold text-white hover:bg-slate-700"
          >
            Înapoi
          </a>
        </div>
      </div>

      <section
        id="loading"
        class="rounded-xl bg-white p-6 shadow"
      >
        Se încarcă produsele...
      </section>

      <section
        id="admin-content"
        class="hidden"
      >
        <div class="mb-6">
          <label
            for="search"
            class="mb-2 block text-sm font-semibold"
          >
            Caută produs
          </label>

          <input
            id="search"
            type="search"
            placeholder="Scrie numele produsului..."
            class="w-full max-w-xl rounded-lg border border-slate-300 bg-white px-4 py-3 outline-none focus:border-blue-600"
          />
        </div>

<div
  id="products-list"
  class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
></div>

        <p
          id="empty-message"
          class="hidden rounded-xl bg-white p-6 text-slate-600 shadow"
        >
          Nu există produse.
        </p>

        <p
          id="message"
          class="hidden rounded-lg px-4 py-3 text-sm"
        ></p>
      </section>
    </main>

    <script>
      import { supabase } from "../lib/supabase.js";

      const loading = document.querySelector("#loading");
      const adminContent =
        document.querySelector("#admin-content");
      const productsList =
        document.querySelector("#products-list");
      const emptyMessage =
        document.querySelector("#empty-message");
      const searchInput =
        document.querySelector("#search");
      const message =
        document.querySelector("#message");

      let toateProdusele = [];

      function showMessage(text, type = "error") {
        message.textContent = text;

        message.classList.remove(
          "hidden",
          "bg-red-100",
          "text-red-700",
          "bg-green-100",
          "text-green-700"
        );

        if (type === "success") {
          message.classList.add(
            "bg-green-100",
            "text-green-700"
          );
        } else {
          message.classList.add(
            "bg-red-100",
            "text-red-700"
          );
        }
      }

      function escapeHtml(text = "") {
        return String(text)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function afiseazaProduse(produse) {
        productsList.innerHTML = "";

        if (!produse.length) {
          emptyMessage.classList.remove("hidden");
          return;
        }

        emptyMessage.classList.add("hidden");

        produse.forEach((produs) => {
          const articol = document.createElement("article");

articol.className =
  "overflow-hidden rounded-xl bg-white shadow transition hover:shadow-md";

const numeCategorie =
  produs.numeCategorie || "Fără categorie";

          const imagine =
            produs.imagine ||
            "/images/fallback-produs.png";

articol.innerHTML = `
  <div class="flex h-36 items-center justify-center bg-slate-50 p-3">
    <img
src="${escapeHtml(imagine)}?v=${Date.now()}"
      alt="${escapeHtml(produs.nume)}"
      class="h-full w-full object-contain"
    />
  </div>

  <div class="p-4">
    <p class="truncate text-xs font-semibold text-blue-700">
      ${escapeHtml(numeCategorie)}
    </p>

    <h2
      class="mt-1 min-h-10 text-sm font-bold leading-5"
      title="${escapeHtml(produs.nume)}"
    >
      ${escapeHtml(produs.nume)}
    </h2>

    <p class="mt-2 text-xs text-slate-500">
      Ordine: ${escapeHtml(produs.ordine ?? 1)}
    </p>

    <div class="mt-3 grid grid-cols-2 gap-2">
      <a
        href="/admin-editeaza-produs/?id=${produs.id}"
        class="rounded-lg bg-blue-700 px-2 py-2 text-center text-xs font-semibold text-white hover:bg-blue-800"
      >
        Modifică
      </a>

      <button
        type="button"
        data-delete-id="${produs.id}"
        data-delete-name="${escapeHtml(produs.nume)}"
        data-delete-image="${escapeHtml(produs.imagine || "")}"
        class="rounded-lg bg-red-700 px-2 py-2 text-xs font-semibold text-white hover:bg-red-800"
      >
        Șterge
      </button>
    </div>
  </div>
`;
          productsList.appendChild(articol);
        });
      }

async function incarcaProduse() {
  const { data: produse, error: produseError } =
    await supabase
      .from("produse")
      .select(`
        id,
        nume,
        slug,
        descriere,
        imagine,
        ordine,
        categorie_id
      `)
      .order("categorie_id")
      .order("ordine");

  if (produseError) {
    showMessage(
      "Produsele nu au putut fi încărcate: " +
        produseError.message
    );
    return;
  }

  const { data: categorii, error: categoriiError } =
    await supabase
      .from("categorii")
      .select("id, nume");

  if (categoriiError) {
    showMessage(
      "Categoriile nu au putut fi încărcate: " +
        categoriiError.message
    );
    return;
  }

  const categoriiMap = new Map(
    (categorii || []).map((categorie) => [
      categorie.id,
      categorie.nume,
    ])
  );

  toateProdusele = (produse || []).map((produs) => ({
    ...produs,
    numeCategorie:
      categoriiMap.get(produs.categorie_id) ||
      "Fără categorie",
  }));

  afiseazaProduse(toateProdusele);

toateProdusele = (produse || []).map((produs) => ({
  ...produs,
  numeCategorie:
    categoriiMap.get(produs.categorie_id) ||
    "Fără categorie",
}));

afiseazaProduse(toateProdusele);
}

      const {
        data: { session },
      } = await supabase.auth.getSession();

      if (!session) {
        window.location.href = "/admin/";
      } else {
        loading.classList.add("hidden");
        adminContent.classList.remove("hidden");
        await incarcaProduse();
      }

      searchInput.addEventListener("input", () => {
        const cautare = searchInput.value
          .trim()
          .toLowerCase();

        const rezultate = toateProdusele.filter(
          (produs) =>
            produs.nume
              .toLowerCase()
              .includes(cautare)
        );

        afiseazaProduse(rezultate);
      });

      productsList.addEventListener(
        "click",
        async (event) => {
          const button = event.target.closest(
            "[data-delete-id]"
          );

          if (!button) {
            return;
          }

          const produsId = Number(
            button.dataset.deleteId
          );

          const produsNume =
            button.dataset.deleteName;

          const confirmare = window.confirm(
            `Sigur vrei să ștergi produsul „${produsNume}”?`
          );

          if (!confirmare) {
            return;
          }

          button.disabled = true;
          button.textContent = "Se șterge...";

          const { error } = await supabase
            .from("produse")
            .delete()
            .eq("id", produsId);

          if (error) {
            showMessage(
              "Produsul nu a putut fi șters: " +
                error.message
            );

            button.disabled = false;
            button.textContent = "Șterge";
            return;
          }

          toateProdusele =
            toateProdusele.filter(
              (produs) => produs.id !== produsId
            );

          afiseazaProduse(toateProdusele);

          showMessage(
            "Produsul a fost șters cu succes.",
            "success"
          );
        }
      );
    </script>
  </body>
</html>