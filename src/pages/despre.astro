---
import "../styles/global.css";
import Header from "../components/Header.astro";
import SeapSection from "../components/SeapSection.astro";
import Footer from "../components/Footer.astro";

const siteUrl = "https://robena.ro";
const pageUrl = `${siteUrl}/despre/`;
const seoTitle = "Despre noi | ROBENA TRADING – furnizor de mobilier și echipamente medicale";
const seoDescription =
  "ROBENA TRADING, companie românească: mobilier medical și metalic, aparatură, echipamente, textile și consumabile pentru spitale, instituții și companii.";

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  url: pageUrl,
  name: seoTitle,
  description: seoDescription,
  inLanguage: "ro-RO",
  about: { "@id": `${siteUrl}/#organization` },
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="ROBENA TRADING" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${siteUrl}/images/hero-robena-transparent.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)}></script>
  </head>

  <body class="bg-slate-50">
   <Header />


    <main>
      <div class="mx-auto max-w-5xl px-6 py-20">
        <h1 class="text-center text-5xl font-bold text-slate-900">
          Despre noi
        </h1>

        <div class="mt-16 rounded-3xl border border-slate-200 bg-white p-10 shadow">
          <h2 class="text-2xl font-bold">
            ROBENA TRADING
          </h2>

          <p class="mt-8 text-lg leading-8 text-slate-700">
            ROBENA TRADING este o companie românească specializată în furnizarea
            unei game variate de produse și echipamente profesionale pentru
            instituții publice, unități medicale, companii și persoane fizice.
          </p>

          <p class="mt-6 text-lg leading-8 text-slate-700">
            Oferim mobilier medical și metalic, mobilier de birou, aparatură,
            echipamente, textile, consumabile și numeroase alte produse
            profesionale, colaborând cu producători și furnizori de încredere
            pentru a răspunde celor mai exigente cerințe.
          </p>

          <p class="mt-6 text-lg leading-8 text-slate-700">
            Ne adresăm spitalelor, clinicilor, centrelor medicale,
            instituțiilor publice, școlilor, companiilor, organizațiilor și
            persoanelor fizice din întreaga țară, oferind soluții complete și
            produse de calitate adaptate fiecărui domeniu de activitate.
          </p>

          <p class="mt-6 text-lg leading-8 text-slate-700">
            Obiectivul nostru este construirea unor parteneriate pe termen lung,
            bazate pe seriozitate, profesionalism, promptitudine și respect
            față de client. Punem accent pe calitatea produselor, consultanță
            dedicată și servicii eficiente înainte și după achiziție.
          </p>

          <p class="mt-6 text-lg leading-8 text-slate-700">
            ROBENA TRADING înseamnă încredere, calitate și soluții profesionale
            pentru orice proiect, indiferent de dimensiunea sau domeniul de
            activitate al beneficiarului.
          </p>
        </div>
      </div>

      <SeapSection />
    </main>

    <Footer />
  </body>
</html>