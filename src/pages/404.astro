---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { categoriiSite } from "../lib/categoriiSite.js";

const categorii = await categoriiSite();
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Pagina nu a fost găsită | ROBENA TRADING</title>
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
  </head>

  <body class="min-h-screen bg-white text-slate-900">
    <Header />

    <main class="mx-auto max-w-3xl px-6 py-20 text-center">
      <p class="font-semibold text-blue-700">Eroare 404</p>

      <h1 class="mt-3 text-4xl font-bold tracking-tight">
        Pagina nu a fost găsită
      </h1>

      <p class="mt-4 leading-7 text-slate-600">
        Este posibil ca produsul să fi fost mutat sau ca adresa să fie greșită.
        Alegeți o categorie de mai jos sau contactați-ne pentru o ofertă.
      </p>

      <ul class="mt-10 grid gap-3 sm:grid-cols-2">
        {
          categorii.map((c) => (
            <li>
              <a
                href={`/produse/${c.slug}/`}
                class="block rounded-xl border border-slate-200 px-5 py-3 font-semibold transition hover:border-blue-300 hover:text-blue-700"
              >
                {c.nume}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href="/contact/"
        class="mt-10 inline-flex rounded-xl bg-blue-700 px-7 py-3 font-semibold text-white transition hover:bg-blue-800"
      >
        Solicită ofertă
      </a>
    </main>

    <Footer />
  </body>
</html>
