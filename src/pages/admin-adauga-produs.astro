---
import "../styles/global.css";
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <link rel="icon" type="image/png" href="/favicon.png?v=2" />

    <title>Adaugă produs | ROBENA TRADING</title>
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-900">
    <main class="mx-auto max-w-3xl px-6 py-10">
      <div class="mb-8 flex items-center justify-between gap-6">
        <div>
          <h1 class="text-3xl font-bold">
            Adaugă produs
          </h1>

          <p class="mt-2 text-slate-600">
            Completează datele produsului.
          </p>
        </div>

        <a
          href="/admin-produse/"
          class="shrink-0 rounded-lg bg-slate-900 px-5 py-3 font-semibold text-white transition hover:bg-slate-700"
        >
          Înapoi
        </a>
      </div>

      <section
        id="loading"
        class="rounded-xl bg-white p-6 shadow"
      >
        Se verifică autentificarea...
      </section>

      <section
        id="admin-content"
        class="hidden rounded-xl bg-white p-6 shadow"
      >
        <form id="product-form" class="space-y-5">
          <div>
            <label
              for="nume"
              class="mb-2 block text-sm font-semibold"
            >
              Nume produs
            </label>

            <input
              id="nume"
              type="text"
              required
              class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-600"
              placeholder="Exemplu: Folie stretch pentru ambalare"
            />
          </div>

          <div>
            <label
              for="slug"
              class="mb-2 block text-sm font-semibold"
            >
              Link produs
            </label>

            <input
              id="slug"
              type="text"
              required
              readonly
              class="w-full cursor-not-allowed rounded-lg border border-slate-300 bg-slate-100 px-4 py-3 text-slate-600 outline-none"
              placeholder="Se generează din numele imaginii"
            />

            <p class="mt-2 text-sm text-slate-500">
              Linkul se generează automat din numele fișierului imaginii,
              fără extensia .png, .jpg sau .webp.
            </p>
          </div>

          <div>
            <label
              for="descriere"
              class="mb-2 block text-sm font-semibold"
            >
              Descriere
            </label>

            <textarea
              id="descriere"
              rows="6"
              required
              class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-600"
            ></textarea>
          </div>

          <div>
            <label
              for="categorie"
              class="mb-2 block text-sm font-semibold"
            >
              Categorie
            </label>

            <select
              id="categorie"
              required
              class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-600"
            >
              <option value="">
                Selectează categoria
              </option>
            </select>
          </div>

          <div>
            <label
              for="imagine"
              class="mb-2 block text-sm font-semibold"
            >
              Imagine produs
            </label>

            <input
              id="imagine"
              type="file"
              accept="image/png,image/jpeg,image/webp"
              required
              class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3"
            />

            <p class="mt-2 text-sm text-slate-500">
              Redenumește imaginea înainte de încărcare. Exemplu:
              folie-stretch-pentru-ambalare.png
            </p>
          </div>

          <div>
            <label
              for="ordine"
              class="mb-2 block text-sm font-semibold"
            >
              Ordine
            </label>

            <input
              id="ordine"
              type="number"
              min="1"
              value="1"
              required
              class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-600"
            />
          </div>

          <button
            id="submit-button"
            type="submit"
            class="rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white transition hover:bg-blue-800 disabled:cursor-not-allowed disabled:opacity-60"
          >
            Salvează produsul
          </button>

          <p
            id="message"
            class="hidden rounded-lg px-4 py-3 text-sm"
          ></p>
        </form>
      </section>
    </main>

    <script>
      import { supabase } from "../lib/supabase.js";

      const loading =
        document.querySelector("#loading");

      const adminContent =
        document.querySelector("#admin-content");

      const form =
        document.querySelector("#product-form");

      const numeInput =
        document.querySelector("#nume");

      const slugInput =
        document.querySelector("#slug");

      const descriereInput =
        document.querySelector("#descriere");

      const categorieSelect =
        document.querySelector("#categorie");

      const imagineInput =
        document.querySelector("#imagine");

      const ordineInput =
        document.querySelector("#ordine");

      const submitButton =
        document.querySelector("#submit-button");

      const message =
        document.querySelector("#message");

      function showMessage(text, type = "error") {
        message.textContent = text;

        message.classList.remove(
          "hidden",
          "bg-red-100",
          "text-red-700",
          "bg-green-100",
          "text-green-700"
        );

        if (type === "success") {
          message.classList.add(
            "bg-green-100",
            "text-green-700"
          );
        } else {
          message.classList.add(
            "bg-red-100",
            "text-red-700"
          );
        }
      }

      function createSlug(text) {
        return String(text ?? "")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "");
      }

      function getSlugFromImage(file) {
        if (!file) {
          return "";
        }

        const numeFaraExtensie =
          file.name.replace(/\.[^/.]+$/, "");

        return createSlug(numeFaraExtensie);
      }

      function asteapta(ms) {
        return new Promise((resolve) => {
          setTimeout(resolve, ms);
        });
      }

      async function pornesteDeploy(session) {
        if (!session?.access_token) {
          throw new Error(
            "Sesiunea de autentificare nu este disponibilă."
          );
        }

        const { data, error } =
          await supabase.functions.invoke(
            "trigger-deploy",
            {
              body: {
                action: "add-product",
                source: "admin-adauga-produs",
                timestamp: new Date().toISOString(),
              },
              headers: {
                Authorization:
                  `Bearer ${session.access_token}`,
              },
            }
          );

        if (error) {
          throw error;
        }

        if (data?.success === false) {
          throw new Error(
            data?.message ||
              "GitHub nu a confirmat pornirea deployment-ului."
          );
        }

        return data;
      }

      imagineInput.addEventListener("change", () => {
        const fisierImagine =
          imagineInput.files?.[0];

        slugInput.value =
          getSlugFromImage(fisierImagine);
      });

      const {
        data: { session },
      } = await supabase.auth.getSession();

      if (!session) {
        window.location.href = "/admin/";
      } else {
        loading.classList.add("hidden");
        adminContent.classList.remove("hidden");
      }

      const {
        data: categorii,
        error: categoriiError,
      } = await supabase
        .from("categorii")
        .select("id, nume")
        .order("id", { ascending: true });

      if (categoriiError) {
        showMessage(
          "Categoriile nu au putut fi încărcate: " +
            categoriiError.message
        );
      } else {
        (categorii ?? []).forEach((categorie) => {
          const option =
            document.createElement("option");

          option.value =
            String(categorie.id);

          option.textContent =
            categorie.nume;

          categorieSelect.appendChild(option);
        });
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        submitButton.disabled = true;
        submitButton.textContent = "Se salvează...";

        const nume =
          numeInput.value.trim();

        const descriere =
          descriereInput.value.trim();

        const categorieId =
          Number(categorieSelect.value);

        const ordine =
          Number(ordineInput.value);

        const fisierImagine =
          imagineInput.files?.[0];

        if (!fisierImagine) {
          showMessage(
            "Selectează o imagine pentru produs."
          );

          submitButton.disabled = false;
          submitButton.textContent =
            "Salvează produsul";

          return;
        }

        const slug =
          getSlugFromImage(fisierImagine);

        slugInput.value = slug;

        if (!slug) {
          showMessage(
            "Numele imaginii nu poate fi transformat într-un link valid."
          );

          submitButton.disabled = false;
          submitButton.textContent =
            "Salvează produsul";

          return;
        }

        if (
          !nume ||
          !descriere ||
          !categorieId ||
          !ordine
        ) {
          showMessage(
            "Completează toate câmpurile obligatorii."
          );

          submitButton.disabled = false;
          submitButton.textContent =
            "Salvează produsul";

          return;
        }

        const {
          data: produsExistent,
          error: verificareSlugError,
        } = await supabase
          .from("produse")
          .select("id")
          .eq("slug", slug)
          .maybeSingle();

        if (verificareSlugError) {
          showMessage(
            "Linkul produsului nu a putut fi verificat: " +
              verificareSlugError.message
          );

          submitButton.disabled = false;
          submitButton.textContent =
            "Salvează produsul";

          return;
        }

        if (produsExistent) {
          showMessage(
            "Există deja un produs cu acest link. Redenumește imaginea și selecteaz-o din nou."
          );

          submitButton.disabled = false;
          submitButton.textContent =
            "Salvează produsul";

          return;
        }

        const extensie =
          fisierImagine.name
            .split(".")
            .pop()
            .toLowerCase();

        const numeFisier =
          `${slug}-${Date.now()}.${extensie}`;

        const { error: uploadError } =
          await supabase.storage
            .from("produse")
            .upload(
              numeFisier,
              fisierImagine,
              {
                cacheControl: "3600",
                upsert: false,
                contentType:
                  fisierImagine.type,
              }
            );

        if (uploadError) {
          showMessage(
            "Imaginea nu a putut fi încărcată: " +
              uploadError.message
          );

          submitButton.disabled = false;
          submitButton.textContent =
            "Salvează produsul";

          return;
        }

        const { data: publicUrlData } =
          supabase.storage
            .from("produse")
            .getPublicUrl(numeFisier);

        const produs = {
          nume,
          slug,
          descriere,
          categorie_id: categorieId,
          imagine: publicUrlData.publicUrl,
          ordine,
        };

        const {
          data: produsSalvat,
          error: insertError,
        } = await supabase
          .from("produse")
          .insert(produs)
          .select("id, slug, categorie_id")
          .single();

        if (insertError) {
          await supabase.storage
            .from("produse")
            .remove([numeFisier]);

          showMessage(
            "Produsul nu a putut fi salvat: " +
              insertError.message
          );

          submitButton.disabled = false;
          submitButton.textContent =
            "Salvează produsul";

          return;
        }

        /*
         * Verificăm că produsul poate fi citit din Supabase
         * înainte să pornim build-ul Astro.
         */
        let produsConfirmat = false;

        for (let incercare = 0; incercare < 5; incercare++) {
          const {
            data: verificareProdus,
            error: verificareProdusError,
          } = await supabase
            .from("produse")
            .select("id")
            .eq("id", produsSalvat.id)
            .maybeSingle();

          if (
            !verificareProdusError &&
            verificareProdus
          ) {
            produsConfirmat = true;
            break;
          }

          await asteapta(500);
        }

        if (!produsConfirmat) {
          console.warn(
            "Produsul a fost salvat, dar nu a putut fi reconfirmat înainte de deploy."
          );
        }

        /*
         * Mică pauză înainte de GitHub build.
         * Astfel ne asigurăm că build-ul citește produsul nou.
         */
        await asteapta(1000);

        submitButton.textContent =
          "Se actualizează site-ul...";

        try {
          const rezultatDeploy =
            await pornesteDeploy(session);

          console.log(
            "Deployment GitHub pornit:",
            rezultatDeploy
          );

          showMessage(
            "Produsul a fost adăugat cu succes. Actualizarea site-ului a fost pornită automat. Pagina produsului va fi disponibilă în aproximativ 1 minut.",
            "success"
          );
        } catch (deployError) {
          console.error(
            "Produsul a fost salvat, dar deploy-ul nu a pornit:",
            deployError
          );

          showMessage(
            "Produsul a fost adăugat în Supabase, dar actualizarea automată a site-ului nu a pornit. Verifică funcția trigger-deploy.",
            "error"
          );
        }

        form.reset();
        slugInput.value = "";

        submitButton.disabled = false;
        submitButton.textContent =
          "Salvează produsul";
      });
    </script>
  </body>
</html>