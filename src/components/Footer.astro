---
/* =========================================================
   Subsol simplu, comun pentru toate paginile publice.
   Datele firmei sunt în src/lib/firma.js.
   ========================================================= */
import { firma } from "../lib/firma.js";

const an = new Date().getFullYear();
---

<footer id="contact" class="bg-white">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-3 px-6 py-8 text-sm text-slate-600 md:flex-row md:items-center md:justify-between"
  >
    <p>© {an} {firma.nume}</p>

    <p class="flex flex-wrap gap-x-6 gap-y-2">
      <a href={`tel:${firma.telefon}`} class="hover:text-blue-700">
        {firma.telefonAfisat}
      </a>
      <a href={`mailto:${firma.email}`} class="hover:text-blue-700">
        {firma.email}
      </a>
      <a href="/contact/" class="hover:text-blue-700">Solicită ofertă</a>
    </p>
  </div>
</footer>
