<header
  class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between px-6 py-3"
  >
    <!-- Logo -->
    <a
      href="/"
      aria-label="ROBENA TRADING - Acasă"
      class="shrink-0"
    >
      <img
        src="/images/logo-robena.png"
        alt="ROBENA TRADING"
        class="h-24 w-auto object-contain md:h-32"
      />
    </a>

    <!-- Meniu -->
    <nav
      class="hidden items-center gap-8 text-sm font-semibold text-slate-700 md:flex"
    >
      <a
        class="transition hover:text-blue-700"
        href="/"
      >
        Acasă
      </a>

      <!-- Produse -->
      <div class="group relative">
        <a
          href="/#produse"
          class="flex items-center gap-2 py-5 transition hover:text-blue-700"
        >
          Produse

          <svg
            class="h-4 w-4 transition-transform duration-200 group-hover:rotate-180"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"
              clip-rule="evenodd"
            />
          </svg>
        </a>

        <!-- Lista Produse -->
        <div
          class="invisible absolute left-1/2 top-full z-[100] w-64
                 -translate-x-1/2 pt-2 opacity-0
                 transition-all duration-200
                 group-hover:visible group-hover:opacity-100"
        >
          <div
            class="rounded-2xl border border-slate-200 bg-white p-3 shadow-xl"
          >
            <a
              href="/produse/mobilier-medical/"
              class="block rounded-lg px-4 py-3 hover:bg-slate-100 hover:text-blue-700"
            >
              Mobilier medical
            </a>

            <a
              href="/produse/mobilier-metalic/"
              class="block rounded-lg px-4 py-3 hover:bg-slate-100 hover:text-blue-700"
            >
              Mobilier metalic
            </a>

            <a
              href="/produse/mobilier-de-birou/"
              class="block rounded-lg px-4 py-3 hover:bg-slate-100 hover:text-blue-700"
            >
              Mobilier de birou
            </a>

            <a
              href="/produse/aparatura/"
              class="block rounded-lg px-4 py-3 hover:bg-slate-100 hover:text-blue-700"
            >
              Aparatură
            </a>

            <a
              href="/produse/echipamente/"
              class="block rounded-lg px-4 py-3 hover:bg-slate-100 hover:text-blue-700"
            >
              Echipamente
            </a>

            <a
              href="/produse/textile/"
              class="block rounded-lg px-4 py-3 hover:bg-slate-100 hover:text-blue-700"
            >
              Textile
            </a>

            <a
              href="/produse/consumabile/"
              class="block rounded-lg px-4 py-3 hover:bg-slate-100 hover:text-blue-700"
            >
              Consumabile
            </a>

            <a
              href="/produse/alte-produse/"
              class="block rounded-lg px-4 py-3 hover:bg-slate-100 hover:text-blue-700"
            >
              Alte produse
            </a>
          </div>
        </div>
      </div>

      <a
        class="transition hover:text-blue-700"
        href="/despre/"
      >
        Despre noi
      </a>

      <a
        class="transition hover:text-blue-700"
        href="/contact/"
      >
        Contact
      </a>
    </nav>

    <!-- Lupă + buton ofertă -->
    <div class="flex items-center gap-3">
      <button
        id="buton-cautare-produse"
        type="button"
        aria-label="Caută produse"
        aria-expanded="false"
        class="flex h-11 w-11 items-center justify-center rounded-full text-slate-700 transition hover:bg-slate-100 hover:text-blue-700"
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>

      <a
        href="/contact/"
        class="rounded-lg bg-blue-700 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blue-800 md:px-6 md:py-4"
      >
        Solicită ofertă
      </a>
    </div>
  </div>

  <!-- Zona de căutare -->
  <div
    id="panou-cautare-produse"
    class="hidden border-t border-slate-200 bg-white shadow-lg"
  >
    <div class="mx-auto max-w-3xl px-6 py-5">
      <div class="relative">
        <svg
          class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>

        <input
          id="camp-cautare-produse"
          type="search"
          autocomplete="off"
          placeholder="Scrie unul sau mai multe cuvinte..."
          class="w-full rounded-xl border border-slate-300 py-4 pl-12 pr-14 text-base outline-none transition focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
        />

        <button
          id="inchide-cautare-produse"
          type="button"
          aria-label="Închide căutarea"
          class="absolute right-3 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12"></path>
            <path d="M18 6 6 18"></path>
          </svg>
        </button>
      </div>

      <div
        id="mesaj-cautare-produse"
        class="hidden py-5 text-center text-sm text-slate-500"
      ></div>

      <div
        id="rezultate-cautare-produse"
        class="mt-3 hidden max-h-[420px] overflow-y-auto rounded-xl border border-slate-200 bg-white"
      ></div>
    </div>
  </div>
</header>

<script>
  import { supabase } from "../lib/supabase.js";

  const butonCautare =
    document.querySelector("#buton-cautare-produse");

  const panouCautare =
    document.querySelector("#panou-cautare-produse");

  const campCautare =
    document.querySelector("#camp-cautare-produse");

  const inchideCautare =
    document.querySelector("#inchide-cautare-produse");

  const rezultateCautare =
    document.querySelector("#rezultate-cautare-produse");

  const mesajCautare =
    document.querySelector("#mesaj-cautare-produse");

  let timerCautare;
  let toateProdusele = null;

  /*
    Aceste cuvinte sunt ignorate la căutare.

    Exemplu:
    "pat de examinare"
    devine:
    ["pat", "examinare"]
  */
  const cuvinteIgnorate = new Set([
    "de",
    "din",
    "pentru",
    "cu",
    "si",
    "sau",
    "la",
    "in",
    "pe",
    "un",
    "o",
    "al",
    "ale",
    "a",
    "lui",
    "lor",
  ]);

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  /*
    Transformă:
    "Masă medicală"
    în:
    "masa medicala"
  */
  function eliminaDiacritice(text) {
    return String(text ?? "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();
  }

  /*
    Separă textul introdus în cuvinte individuale.

    Exemplu:
    "pat examinare medicala"
    devine:
    ["pat", "examinare", "medicala"]
  */
  function extrageCuvinteCautare(text) {
    return eliminaDiacritice(text)
      .split(/[^a-z0-9]+/)
      .map((cuvant) => cuvant.trim())
      .filter(
        (cuvant) =>
          cuvant.length >= 2 &&
          !cuvinteIgnorate.has(cuvant)
      );
  }

  /*
    Verifică dacă un cuvânt introdus se potrivește
    cu numele produsului.

    Acceptă:
    - cuvânt complet;
    - început de cuvânt;
    - fragment de minimum 3 litere.

    Exemplu:
    "exam"
    găsește:
    "examinare"
  */
  function cuvantSePotriveste(
    cuvantCautat,
    numeNormalizat
  ) {
    const cuvinteProdus =
      numeNormalizat.split(/[^a-z0-9]+/);

    return cuvinteProdus.some(
      (cuvantProdus) => {
        if (cuvantProdus === cuvantCautat) {
          return true;
        }

        if (
          cuvantProdus.startsWith(cuvantCautat)
        ) {
          return true;
        }

        if (
          cuvantCautat.length >= 3 &&
          cuvantProdus.includes(cuvantCautat)
        ) {
          return true;
        }

        return false;
      }
    );
  }

  /*
    Calculează ordinea rezultatelor.

    Produsele cu potriviri mai exacte
    apar primele.
  */
  function calculeazaScor(
    numeProdus,
    cuvinteCautate
  ) {
    const numeNormalizat =
      eliminaDiacritice(numeProdus);

    const cuvinteProdus =
      numeNormalizat.split(/[^a-z0-9]+/);

    let scor = 0;

    for (const cuvantCautat of cuvinteCautate) {
      if (
        cuvinteProdus.includes(cuvantCautat)
      ) {
        scor += 20;
        continue;
      }

      if (
        cuvinteProdus.some(
          (cuvantProdus) =>
            cuvantProdus.startsWith(
              cuvantCautat
            )
        )
      ) {
        scor += 10;
        continue;
      }

      if (
        cuvantCautat.length >= 3 &&
        numeNormalizat.includes(
          cuvantCautat
        )
      ) {
        scor += 5;
      }
    }

    return scor;
  }

  function deschidePanoulCautare() {
    panouCautare.classList.remove("hidden");

    butonCautare.setAttribute(
      "aria-expanded",
      "true"
    );

    setTimeout(() => {
      campCautare.focus();
    }, 50);
  }

  function inchidePanoulCautare() {
    panouCautare.classList.add("hidden");

    butonCautare.setAttribute(
      "aria-expanded",
      "false"
    );

    campCautare.value = "";

    rezultateCautare.innerHTML = "";
    rezultateCautare.classList.add("hidden");

    mesajCautare.textContent = "";
    mesajCautare.classList.add("hidden");
  }

  function afiseazaMesaj(text) {
    rezultateCautare.innerHTML = "";
    rezultateCautare.classList.add("hidden");

    mesajCautare.textContent = text;
    mesajCautare.classList.remove("hidden");
  }

  function afiseazaRezultate(produse) {
    mesajCautare.textContent = "";
    mesajCautare.classList.add("hidden");

    rezultateCautare.innerHTML = produse
      .map((produs) => {
        const nume =
          escapeHtml(produs.nume);

        const imagine =
          escapeHtml(produs.imagine ?? "");

        const slug =
          encodeURIComponent(
            produs.slug ?? ""
          );

        return `
          <a
            href="/produs/?slug=${slug}"
            class="flex items-center gap-4 border-b border-slate-100 px-4 py-3 transition last:border-b-0 hover:bg-slate-50"
          >
            <div
              class="flex h-16 w-16 shrink-0 items-center justify-center rounded-lg bg-slate-50"
            >
              ${
                imagine
                  ? `
                    <img
                      src="${imagine}"
                      alt="${nume}"
                      class="h-full w-full object-contain"
                    />
                  `
                  : `
                    <span class="text-xs text-slate-400">
                      Fără imagine
                    </span>
                  `
              }
            </div>

            <div class="min-w-0">
              <p class="font-semibold text-slate-900">
                ${nume}
              </p>

              <p class="mt-1 text-sm text-blue-700">
                Vezi produsul →
              </p>
            </div>
          </a>
        `;
      })
      .join("");

    rezultateCautare.classList.remove(
      "hidden"
    );
  }

  async function incarcaToateProdusele() {
    if (toateProdusele) {
      return toateProdusele;
    }

    const { data: produse, error } =
      await supabase
        .from("produse")
        .select(
          "id, nume, slug, imagine"
        )
        .order("nume", {
          ascending: true,
        });

    if (error) {
      throw error;
    }

    toateProdusele = produse ?? [];

    return toateProdusele;
  }

  async function cautaProduse(textCautat) {
    const cuvinteCautate =
      extrageCuvinteCautare(
        textCautat
      );

    if (cuvinteCautate.length === 0) {
      rezultateCautare.innerHTML = "";
      rezultateCautare.classList.add(
        "hidden"
      );

      mesajCautare.textContent =
        "Scrie cel puțin două litere.";

      mesajCautare.classList.remove(
        "hidden"
      );

      return;
    }

    afiseazaMesaj(
      "Se caută produsele..."
    );

    try {
      const produse =
        await incarcaToateProdusele();

      const produseGasite = produse
        .map((produs) => {
          const numeNormalizat =
            eliminaDiacritice(
              produs.nume
            );

          /*
            Toate cuvintele importante introduse
            trebuie să existe în numele produsului.

            Exemplu:
            "pat examinare"
            găsește:
            "Pat de examinare medicală"
          */
          const toateCuvinteleSePotrivesc =
            cuvinteCautate.every(
              (cuvantCautat) =>
                cuvantSePotriveste(
                  cuvantCautat,
                  numeNormalizat
                )
            );

          return {
            ...produs,
            sePotriveste:
              toateCuvinteleSePotrivesc,
            scor: calculeazaScor(
              produs.nume,
              cuvinteCautate
            ),
          };
        })
        .filter(
          (produs) =>
            produs.sePotriveste
        )
        .sort((a, b) => {
          if (b.scor !== a.scor) {
            return b.scor - a.scor;
          }

          return a.nume.localeCompare(
            b.nume,
            "ro"
          );
        })
        .slice(0, 10);

      if (
        produseGasite.length === 0
      ) {
        afiseazaMesaj(
          "Nu a fost găsit niciun produs."
        );

        return;
      }

      afiseazaRezultate(
        produseGasite
      );
    } catch (error) {
      console.error(
        "Eroare la căutarea produselor:",
        error
      );

      afiseazaMesaj(
        "Produsele nu au putut fi căutate."
      );
    }
  }

  butonCautare.addEventListener(
    "click",
    () => {
      const esteDeschis =
        !panouCautare.classList.contains(
          "hidden"
        );

      if (esteDeschis) {
        inchidePanoulCautare();
      } else {
        deschidePanoulCautare();
      }
    }
  );

  inchideCautare.addEventListener(
    "click",
    inchidePanoulCautare
  );

  campCautare.addEventListener(
    "input",
    () => {
      clearTimeout(timerCautare);

      timerCautare = setTimeout(
        () => {
          cautaProduse(
            campCautare.value
          );
        },
        200
      );
    }
  );

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key === "Escape" &&
        !panouCautare.classList.contains(
          "hidden"
        )
      ) {
        inchidePanoulCautare();
      }
    }
  );
</script>