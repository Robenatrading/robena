---
import "../../../styles/global.css";
import Header from "../../../components/Header.astro";
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Concentratoare de oxigen oferite de ROBENA TRADING pentru unități medicale, centre de îngrijire și utilizare la domiciliu."
    />

    <title>Concentrator de oxigen | ROBENA TRADING</title>
  </head>

  <body class="bg-slate-50 text-slate-900">
    <Header />

    <main>
      <section class="mx-auto max-w-7xl px-6 py-12">
        <div class="grid items-center gap-12 lg:grid-cols-2">

          <div class="flex items-center justify-center rounded-2xl bg-white p-8">
            <img
              src="/images/categorii/concentrator-de-oxigen-portabil-robena-trading.png"
              alt="Concentrator de oxigen"
              class="max-h-[550px] w-full object-contain"
            />
          </div>

          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-blue-700">
              Aparatură medicală
            </p>

            <h1 class="mt-3 text-4xl font-bold text-slate-900 md:text-5xl">
              Concentrator de oxigen
            </h1>

            <p class="mt-6 text-lg leading-8 text-slate-600">
              ROBENA TRADING furnizează concentratoare de oxigen destinate
              spitalelor, clinicilor, cabinetelor medicale, centrelor de
              îngrijire și utilizării la domiciliu. Produsele sunt disponibile
              în diferite capacități și configurații și pot fi selectate în
              funcție de cerințele și necesitățile beneficiarului.
            </p>

            <ul class="mt-8 space-y-3 text-slate-700">
              <li>• Capacități și debite variate</li>
              <li>• Modele pentru utilizare medicală și la domiciliu</li>
              <li>• Configurații adaptate cerințelor beneficiarului</li>
              <li>• Opțiuni cu umidificator și accesorii</li>
              <li>• Soluții pentru utilizare continuă sau temporară</li>
              <li>• Selectare în funcție de necesarul proiectului</li>
            </ul>

            <a
              href="/contact"
              class="mt-10 inline-flex rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white transition hover:bg-blue-800"
            >
              Solicită ofertă
            </a>
          </div>
        </div>
      </section>

      <section class="bg-slate-900 text-white">
        <div class="mx-auto max-w-7xl px-6 py-12 text-center">
          <h2 class="text-2xl font-bold">
            NE GĂSIȚI ȘI PE SEAP!
          </h2>

          <p class="mt-3 text-slate-300">
            Produsele ROBENA TRADING pot fi achiziționate și prin platforma
            SEAP.
          </p>
        </div>
      </section>
    </main>
  </body>
</html>